#!/bin/bash
# Unit tests, then the GPU parity tests when reference fixtures exist.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
./script/build build-for-testing
extra=()
if [[ -d .build/fixtures ]]; then
  # xcodebuild passes TEST_RUNNER_-prefixed variables to the tests.
  extra+=("TEST_RUNNER_DEMUCS_FIXTURE_DIRECTORY=$root/.build/fixtures"
    "TEST_RUNNER_DEMUCS_SPECTRAL_CACHE=$root/.build/test-spectral-cache.json")
  if [[ -f .build/full-fixtures/audio_30.safetensors && -f .build/models/htdemucs_ft.safetensors ]]; then
    extra+=("TEST_RUNNER_DEMUCS_FULL_FIXTURES=$root/.build/full-fixtures"
      "TEST_RUNNER_DEMUCS_MODEL_DIRECTORY=$root/.build/models")
  fi
fi
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
status=0
env "${extra[@]}" xcodebuild -scheme demucs-mlx-swift-Package -configuration Release \
  -destination 'platform=macOS,arch=arm64,variant=macos' -derivedDataPath "$root/.build/xcode" \
  -skipPackagePluginValidation MTL_IGNORE_WARNINGS=YES ENABLE_TESTABILITY=YES \
  test-without-building >"$log" 2>&1 || status=$?
# Show results and failures, not Metal's runtime shader-compilation chatter.
grep -E "Test run with|recorded an issue|failed|error:|skipped|TEST (SUCCEEDED|FAILED)" "$log" || true
exit "$status"
