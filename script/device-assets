#!/bin/bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cache="${1:-$root/.build/models}"
mkdir -p "$root/.build/iOSAssets"
cp "$cache/htdemucs.safetensors" "$cache/htdemucs_config.json" "$root/.build/iOSAssets/"
cp "$root/.build/full-fixtures/audio_1.safetensors" "$root/.build/full-fixtures/reference_1_gpu.safetensors" "$root/.build/iOSAssets/"
